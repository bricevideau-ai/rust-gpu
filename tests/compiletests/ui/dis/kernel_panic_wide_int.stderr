               OpCapability Addresses
               OpCapability Kernel
               OpCapability Vector16
               OpCapability Float16Buffer
               OpCapability Int64
          %1 = OpExtInstImport "NonSemantic.DebugPrintf"
               OpMemoryModel Physical64 OpenCL
               OpEntryPoint Kernel %2 "main"
          %3 = OpString "/n[Rust panicked at $DIR/kernel_panic_wide_int.rs:26:9]/n got u64 zero: %lu/n      in main()/n"
          %4 = OpString "$DIR/kernel_panic_wide_int.rs"
                              OpName %value "value"
       %void = OpTypeVoid
        %u64 = OpTypeInt 64 0
          %8 = OpTypeFunction %void %u64
       %bool = OpTypeBool
      %u64_0 = OpConstant %u64 0
