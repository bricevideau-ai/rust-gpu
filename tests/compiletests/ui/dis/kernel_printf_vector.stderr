OpCapability Addresses
OpCapability Kernel
OpCapability Vector16
OpCapability Float16Buffer
OpCapability Int8
%1 = OpExtInstImport "OpenCL.std"
OpMemoryModel Physical64 OpenCL
OpEntryPoint Kernel %2 "main"
%4 = OpString "$DIR/kernel_printf_vector.rs"
OpName %5 "kernel_printf_vector::main"
OpName %6 "spirv_std::debug_printf::assert_is_vector::<f32, glam::f32::scalar::vec4::Vec4, 4>"
%7 = OpTypeVoid
%8 = OpTypeFunction %7
%9 = OpTypeFloat 32
%10 = OpTypeVector %9 4
%11 = OpConstant  %9  1065353216
%12 = OpConstant  %9  1073741824
%13 = OpConstant  %9  1077936128
%14 = OpConstant  %9  1082130432
%15 = OpTypeFunction %10 %10
%16 = OpTypeInt 32 0
%17 = OpTypeInt 8 0
%18 = OpConstant  %16  6
%19 = OpTypeArray %17 %18
%20 = OpTypePointer UniformConstant %19
%21 = OpConstant  %17  37
%22 = OpConstant  %17  118
%23 = OpConstant  %17  52
%24 = OpConstant  %17  102
%25 = OpConstant  %17  10
%26 = OpConstant  %17  0
%27 = OpConstantComposite  %19  %21 %22 %23 %24 %25 %26
%28 = OpVariable  %20  UniformConstant %27
